generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
  sessions     Session[]
  companies    Company[]
  documents    Document[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  website   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  jobOffers JobOffer[]

  @@index([userId])
}

model JobOffer {
  id           Int           @id @default(autoincrement())
  title        String
  url          String?
  description  String?
  location     String?
  contractType ContractType?
  salary       String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]

  @@index([companyId])
}

model Application {
  id           Int               @id @default(autoincrement())
  status       ApplicationStatus @default(DRAFT)
  appliedAt    DateTime?
  source       String?
  notes        String?
  contactName  String?
  contactEmail String?
  documents    Document[]
  followUpAt   DateTime?
  interviewAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  jobOfferId Int
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id])

  events ApplicationEvent[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([userId, followUpAt])
  @@index([userId, interviewAt])
  @@index([jobOfferId])
}

model Document {
  id           Int          @id @default(autoincrement())
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  type         DocumentType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  applicationId Int?
  application   Application? @relation(fields: [applicationId], references: [id])

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, applicationId])
}

model ApplicationEvent {
  id          Int                  @id @default(autoincrement())
  type        ApplicationEventType
  title       String
  description String?
  occurredAt  DateTime             @default(now())
  createdAt   DateTime             @default(now())

  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, occurredAt])
}

enum ApplicationEventType {
  CREATED
  STATUS_CHANGED
  APPLICATION_SENT
  FOLLOW_UP
  INTERVIEW
  DOCUMENT_ADDED
  NOTE
  OTHER
}

enum DocumentType {
  CV
  COVER_LETTER
  JOB_OFFER
  OTHER
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  FOLLOW_UP
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  FREELANCE
  TEMPORARY
  OTHER
}
