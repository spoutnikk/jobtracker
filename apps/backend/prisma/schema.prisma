generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  website   String?
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobOffers JobOffer[]
}

model JobOffer {
  id           Int           @id @default(autoincrement())
  title        String
  url          String?
  description  String?
  location     String?
  contractType ContractType?
  salary       String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  companyId    Int
  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
}

model Application {
  id           Int               @id @default(autoincrement())
  status       ApplicationStatus @default(DRAFT)
  appliedAt    DateTime?
  source       String?
  notes        String?
  contactName  String?
  contactEmail String?
  documents    Document[]
  followUpAt   DateTime?
  interviewAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])

  jobOfferId Int
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id])
}

model Document {
  id           Int          @id @default(autoincrement())
  name         String
  originalName String
  mimeType     String
  size         Int
  path         String
  type         DocumentType
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  applicationId Int?
  application   Application? @relation(fields: [applicationId], references: [id])
}

enum DocumentType {
  CV
  COVER_LETTER
  JOB_OFFER
  OTHER
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  FOLLOW_UP
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum ContractType {
  CDI
  CDD
  INTERNSHIP
  FREELANCE
  TEMPORARY
  OTHER
}
